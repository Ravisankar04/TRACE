# Database
DATABASE_URL=postgresql://trace:trace@localhost:5432/trace?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Session / Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# AI (OpenAI-compatible or OpenRouter)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Snapshot storage (local by default; S3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Crawler
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=25
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT_MS=30000
CRAWL_RESPECT_ROBOTS=true

# Demo
DEMO_SITE_URL=http://localhost:3000/demo-site

# Logging
LOG_LEVEL=info
NODE_ENV=development
